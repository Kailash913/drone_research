+)
+INPUTS = (
+    {
+        'mode': ('/fmu/in/offboard_control_mode', OffboardControlMode),
+        'trajectory': ('/fmu/in/trajectory_setpoint', TrajectorySetpoint),
+        'command': ('/fmu/in/vehicle_command', VehicleCommand)
